---
import '@/styles/global.css';
import type { Locale } from '@/i18n';
import { LOCALES, absoluteUrl, localeHtmlLang } from '@/i18n';
import { SITE } from '@/config/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Current page path, starting with a slash and ending with a slash. */
  path: string;
  /** Paths of this page in each locale. Omit for pages that exist in a single language. */
  alternates?: Partial<Record<Locale, string>>;
  ogImage?: string;
  noindex?: boolean;
}

const { locale, title, description, path, alternates, ogImage = '/og.png', noindex = false } = Astro.props;

const canonical = absoluteUrl(SITE.url, path);
const ogImageUrl = absoluteUrl(SITE.url, ogImage);
const hreflangs = alternates
  ? LOCALES.filter((l) => alternates[l]).map((l) => ({ lang: localeHtmlLang[l], href: absoluteUrl(SITE.url, alternates[l] as string) }))
  : [];
const xDefault = alternates?.tr ? absoluteUrl(SITE.url, alternates.tr) : undefined;
---

<!doctype html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f4f4f2" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body>
    <div class="page" id="top">
      <slot />
    </div>
    <script>
      import '@/scripts/reveal';
    </script>
  </body>
</html>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }
</style>
