---
import type { Locale } from '@/i18n';
import { getDictionary, homePath } from '@/i18n';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Hero from './home/Hero.astro';
import FeaturesGrid from './home/FeaturesGrid.astro';
import HowItWorks from './home/HowItWorks.astro';
import LedgerSection from './home/LedgerSection.astro';
import SecuritySection from './home/SecuritySection.astro';
import Faq from './home/Faq.astro';
import CtaSection from './home/CtaSection.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const alternates: Record<Locale, string> = { tr: homePath('tr'), en: homePath('en') };

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}/icon-512.png`,
      email: SITE.supportEmail,
      founder: { '@type': 'Person', name: SITE.author, url: SITE.authorSite },
    },
    {
      '@type': 'MobileApplication',
      name: SITE.name,
      url: SITE.url,
      description: t.meta.homeDescription,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'iOS, Android',
      inLanguage: locale,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
      author: { '@type': 'Person', name: SITE.author },
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.items.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout locale={locale} title={t.meta.homeTitle} description={t.meta.homeDescription} path={homePath(locale)} alternates={alternates}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Nav locale={locale} alternates={alternates} variant="home" />
  <main>
    <Hero locale={locale} />
    <FeaturesGrid locale={locale} />
    <HowItWorks locale={locale} />
    <LedgerSection locale={locale} />
    <SecuritySection locale={locale} />
    <Faq locale={locale} />
    <CtaSection locale={locale} />
  </main>
  <Footer locale={locale} variant="full" />
</BaseLayout>
