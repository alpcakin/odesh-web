---
import type { Locale } from '@/i18n';
import { getDictionary } from '@/i18n';
import { SITE } from '@/config/site';
import StoreBadges from '../StoreBadges.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const storeTop = SITE.storesLive ? t.hero.storeTopLive : t.hero.storeTop;
---

<section class="container cta-wrap">
  <div class="cta" data-reveal>
    <svg class="mark" viewBox="0 0 96 66" fill="none" aria-hidden="true" focusable="false">
      <circle cx="32.5" cy="33" r="27" stroke="var(--color-accent)" stroke-width="11" class="ring ring-a"></circle>
      <circle cx="63.5" cy="33" r="27" stroke="var(--color-on-dark-light)" stroke-width="11" class="ring ring-b"></circle>
    </svg>
    <h2 class="title">{t.cta.title}</h2>
    <p class="sub">{t.cta.sub}</p>
    <div class="badges">
      <StoreBadges topLabel={storeTop} />
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-block: 0 80px;
  }

  .cta {
    background: var(--color-primary);
    border-radius: 32px;
    padding: clamp(40px, 6vw, 72px) clamp(24px, 5vw, 64px);
    color: #fff;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }

  .mark {
    position: absolute;
    right: -40px;
    top: -40px;
    width: min(52vw, 420px);
    height: auto;
    opacity: 0.9;
  }

  .ring {
    stroke-dasharray: 170;
  }

  .cta.is-visible .ring {
    animation: od-draw 1.6s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  .cta.is-visible .ring-a {
    animation-delay: 0.2s;
  }

  .cta.is-visible .ring-b {
    animation-delay: 0.45s;
  }

  .title {
    margin: 0;
    font-size: clamp(32px, 4.6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 800;
    max-width: 600px;
    position: relative;
    text-wrap: balance;
  }

  .sub {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-on-dark-muted);
    max-width: 520px;
    position: relative;
    text-wrap: pretty;
  }

  .badges {
    position: relative;
  }
</style>
