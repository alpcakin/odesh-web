---
import type { Locale } from '@/i18n';
import { HOME_ANCHORS, getDictionary } from '@/i18n';
import Icon from '../Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section id={HOME_ANCHORS[locale].ledger} class="container section">
  <div class="grid">
    <div class="copy" data-reveal>
      <div class="eyebrow">{t.ledger.eyebrow}</div>
      <h2 class="section-title">{t.ledger.title}</h2>
      <p class="section-lead">{t.ledger.body}</p>
      <ul class="points">
        {
          t.ledger.points.map((p) => (
            <li>
              <Icon name="check" size={18} strokeWidth={2.6} stroke="var(--color-accent-strong)" class="check" />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="card" data-reveal style="--reveal-delay: 100ms">
      <div class="card-head">
        <div class="avatar">BA</div>
        <div class="card-main">
          <div class="contact">{t.ledger.contactName}</div>
          <div class="badge"><Icon name="book" size={9} strokeWidth={2.4} /><span>{t.ledger.badge}</span></div>
        </div>
        <div class="balance">
          <div class="balance-amount tabular">₺220,00</div>
          <div class="balance-sub">{t.ledger.youOwe}</div>
        </div>
      </div>
      {
        t.ledger.rows.map((r) => (
          <div class="row">
            <div class:list={['row-icon', r.negative ? 'negative' : 'positive']}>
              <Icon name="file" size={15} />
            </div>
            <div class="row-main">
              <div class="row-desc">{r.desc}</div>
              <div class="row-date">{r.date}</div>
            </div>
            <div class:list={['row-amount tabular', r.negative ? 'negative' : 'positive']}>{r.amount}</div>
          </div>
        ))
      }
      <div class="settle">{t.ledger.settle}</div>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: 104px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 40px;
    align-items: center;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .points {
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .points li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 15px;
    line-height: 1.5;
  }

  .points :global(.check) {
    flex-shrink: 0;
    margin-top: 3px;
  }

  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 28px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    box-shadow: 0 12px 28px rgba(14, 26, 20, 0.08);
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-border);
  }

  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: var(--color-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 600;
  }

  .card-main {
    flex: 1;
    min-width: 0;
  }

  .contact {
    font-size: 18px;
    font-weight: 700;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: var(--color-primary-soft);
    border-radius: 999px;
    padding: 2px 7px;
    margin-top: 3px;
    color: var(--color-primary);
  }

  .badge span {
    font-size: 10px;
    font-weight: 600;
  }

  .balance {
    text-align: right;
  }

  .balance-amount {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-negative);
    letter-spacing: -0.5px;
  }

  .balance-sub {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .row-icon {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .row-icon.negative {
    background: rgba(209, 75, 67, 0.08);
    color: var(--color-negative);
  }

  .row-icon.positive {
    background: rgba(79, 157, 93, 0.08);
    color: var(--color-positive);
  }

  .row-main {
    flex: 1;
    min-width: 0;
  }

  .row-desc {
    font-size: 15px;
    font-weight: 600;
  }

  .row-date {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .row-amount {
    font-size: 15px;
    font-weight: 700;
  }

  .row-amount.negative {
    color: var(--color-negative);
  }

  .row-amount.positive {
    color: var(--color-positive);
  }

  .settle {
    margin-top: 12px;
    background: var(--color-primary);
    color: #fff;
    border-radius: 999px;
    padding: 14px;
    text-align: center;
    font-size: 15px;
    font-weight: 700;
  }

  @media (max-width: 759px) {
    .section {
      padding-block: 64px;
    }
  }
</style>
