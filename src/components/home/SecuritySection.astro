---
import type { Locale } from '@/i18n';
import { HOME_ANCHORS, getDictionary, legalPath } from '@/i18n';
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const ICON_MAP: Record<string, IconName> = { map: 'globe', eyeoff: 'eye-off', lock: 'lock', slash: 'slash', toggle: 'toggle', trash: 'trash' };
---

<section id={HOME_ANCHORS[locale].security} class="security">
  <div class="container section">
    <div class="intro" data-reveal>
      <div class="eyebrow on-dark">{t.security.eyebrow}</div>
      <h2 class="section-title">{t.security.title}</h2>
      <p class="section-lead on-dark">{t.security.sub}</p>
    </div>
    <div class="grid">
      {
        t.security.items.map((it, i) => (
          <div class="item" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <Icon name={ICON_MAP[it.icon] ?? 'lock'} size={22} stroke="var(--color-accent)" />
            <div class="item-title">{it.title}</div>
            <div class="item-body">{it.body}</div>
          </div>
        ))
      }
    </div>
    <div class="links">
      <a href={legalPath('aydinlatma')} hreflang="tr">{t.security.privacyLink}</a>
      <a href={legalPath('kosullar')} hreflang="tr">{t.security.termsLink}</a>
      <a href={legalPath('veri-silme')} hreflang="tr">{t.security.deleteLink}</a>
    </div>
  </div>
</section>

<style>
  .security {
    background: var(--color-primary-dark);
    color: #fff;
  }

  .section {
    padding-block: 104px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 680px;
    margin-bottom: 44px;
  }

  .eyebrow.on-dark {
    color: var(--color-on-dark-faint);
  }

  .section-lead.on-dark {
    color: var(--color-on-dark-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 14px;
  }

  .item {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 22px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .item-title {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
  }

  .item-body {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-on-dark-muted);
    text-wrap: pretty;
  }

  .links {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 14px;
  }

  .links a {
    color: var(--color-on-dark-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .links a:hover {
    color: #fff;
  }

  @media (max-width: 759px) {
    .section {
      padding-block: 64px;
    }
  }
</style>
