---
import type { Locale } from '@/i18n';
import { LOCALES } from '@/i18n';

interface Props {
  locale: Locale;
  alternates: Record<Locale, string>;
  label: string;
}

const { locale, alternates, label } = Astro.props;
const NAMES: Record<Locale, string> = { tr: 'Türkçe', en: 'English' };
---

<nav class="lang" aria-label={label}>
  {
    LOCALES.map((code) => (
      <a
        href={alternates[code]}
        hreflang={code}
        lang={code}
        class:list={['lang-option', { 'is-active': code === locale }]}
        aria-current={code === locale ? 'true' : undefined}
        aria-label={NAMES[code]}
      >
        {code.toUpperCase()}
      </a>
    ))
  }
</nav>

<style>
  .lang {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    border-radius: 999px;
    padding: 3px;
    gap: 2px;
  }

  .lang-option {
    font-size: 12px;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: 999px;
    color: var(--color-text-muted);
    transition:
      background 0.25s,
      color 0.25s;
  }

  .lang-option:hover {
    color: var(--color-primary);
  }

  .lang-option.is-active,
  .lang-option.is-active:hover {
    background: var(--color-primary);
    color: #fff;
  }
</style>
