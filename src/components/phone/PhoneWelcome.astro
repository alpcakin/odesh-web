---
import PhoneScreen from './PhoneScreen.astro';
import BrandMark from '../BrandMark.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;

const APPLE_ICON =
  '<svg width="16" height="16" viewBox="0 0 24 24" fill="#fff" aria-hidden="true" focusable="false"><path d="M16.365 1.43c0 1.14-.493 2.27-1.177 3.08-.744.9-1.99 1.57-2.987 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.572-2.27 1.206-2.98.804-.94 2.142-1.64 3.248-1.68.03.13.05.28.05.43zm4.565 15.71c-.03.07-.463 1.58-1.518 3.12-.945 1.34-1.94 2.71-3.43 2.71-1.517 0-1.9-.88-3.63-.88-1.698 0-2.302.91-3.67.91-1.377 0-2.332-1.26-3.428-2.8-1.287-1.82-2.323-4.63-2.323-7.28 0-4.28 2.797-6.55 5.552-6.55 1.448 0 2.675.95 3.6.95.865 0 2.222-1.01 3.902-1.01.613 0 2.886.06 4.374 2.19-.13.09-2.383 1.37-2.383 4.19 0 3.26 2.854 4.42 2.955 4.45z"/></svg>';
const GOOGLE_ICON =
  '<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"/><path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"/></svg>';
---

<PhoneScreen label={label}>
  <div class="body">
    <div class="hero">
      <BrandMark width={96} />
      <div class="title">Kim kime ne borçlu, bir bakışta.</div>
      <div class="sub">Harcamayı gir, bölüş, IBAN'ı tek dokunuşla kopyala.</div>
    </div>
    <div class="card">
      <div class="card-inner">
        <div class="btn primary">Hesap oluştur</div>
        <div class="or"><i></i><span>veya</span><i></i></div>
        <div class="btn dark"><Fragment set:html={APPLE_ICON} />Apple ile devam et</div>
        <div class="btn light"><Fragment set:html={GOOGLE_ICON} />Google ile devam et</div>
        <div class="login"><span>Hesabın var mı?</span><strong>Giriş Yap</strong></div>
      </div>
    </div>
  </div>
  <div class="home-indicator"><i></i></div>
</PhoneScreen>

<style>
  .body {
    flex: 1;
    padding: 32px;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .title {
    font-size: 32px;
    font-weight: 700;
    line-height: 38px;
    letter-spacing: -0.5px;
    text-align: center;
    text-wrap: balance;
  }

  .sub {
    font-size: 16px;
    line-height: 22px;
    color: var(--color-text-muted);
    text-align: center;
    text-wrap: pretty;
  }

  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(14, 26, 20, 0.08);
  }

  .card-inner {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .btn {
    min-height: 52px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 600;
  }

  .btn.primary {
    background: var(--color-accent);
    color: var(--color-primary-dark);
  }

  .btn.dark {
    background: var(--color-text);
    color: #fff;
  }

  .btn.light {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .or {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 2px 0;
  }

  .or i {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .or span {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .login {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding-top: 4px;
    font-size: 14px;
  }

  .login span {
    color: var(--color-text-muted);
  }

  .login strong {
    font-weight: 600;
    color: var(--color-primary);
  }

  .home-indicator {
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .home-indicator i {
    display: block;
    width: 134px;
    height: 5px;
    border-radius: 3px;
    background: var(--color-text);
  }
</style>
