---
/**
 * Device frame around a 390x844 screen. 'lg' is 330x704 (screen scale 0.7949),
 * 'sm' is 300x640 (screen scale 0.7231). The slot receives `.screen-slot` children.
 */
interface Props {
  size?: 'lg' | 'sm';
  class?: string;
}

const { size = 'lg', class: className } = Astro.props;
---

<div class:list={['frame', size, className]}>
  <div class="glass">
    <slot />
  </div>
  <div class="notch"></div>
</div>

<style>
  .frame {
    background: var(--color-phone-frame);
    position: relative;
  }

  .frame.lg {
    width: 330px;
    height: 704px;
    border-radius: 54px;
    padding: 10px;
  }

  .frame.sm {
    width: 300px;
    height: 640px;
    border-radius: 50px;
    padding: 9px;
  }

  .glass {
    overflow: hidden;
    position: relative;
    background: var(--color-bg);
  }

  .lg .glass {
    width: 310px;
    height: 684px;
    border-radius: 45px;
  }

  .sm .glass {
    width: 282px;
    height: 622px;
    border-radius: 42px;
  }

  .notch {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-phone-frame);
  }

  .lg .notch {
    top: 18px;
    width: 96px;
    height: 27px;
    border-radius: 15px;
  }

  .sm .notch {
    top: 17px;
    width: 86px;
    height: 25px;
    border-radius: 14px;
  }

  .glass :global(.screen-slot) {
    width: 390px;
    height: 844px;
    transform-origin: top left;
    position: absolute;
    left: 0;
    top: 0;
  }

  .lg .glass :global(.screen-slot) {
    transform: scale(0.7949);
  }

  .sm .glass :global(.screen-slot) {
    transform: scale(0.7231);
  }
</style>
