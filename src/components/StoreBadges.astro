---
import { SITE } from '@/config/site';

interface Props {
  topLabel: string;
  id?: string;
}

const { topLabel, id } = Astro.props;
const live = SITE.storesLive;

const APPLE_ICON =
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="#fff" aria-hidden="true" focusable="false"><path d="M16.365 1.43c0 1.14-.493 2.27-1.177 3.08-.744.9-1.99 1.57-2.987 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.572-2.27 1.206-2.98.804-.94 2.142-1.64 3.248-1.68.03.13.05.28.05.43zm4.565 15.71c-.03.07-.463 1.58-1.518 3.12-.945 1.34-1.94 2.71-3.43 2.71-1.517 0-1.9-.88-3.63-.88-1.698 0-2.302.91-3.67.91-1.377 0-2.332-1.26-3.428-2.8-1.287-1.82-2.323-4.63-2.323-7.28 0-4.28 2.797-6.55 5.552-6.55 1.448 0 2.675.95 3.6.95.865 0 2.222-1.01 3.902-1.01.613 0 2.886.06 4.374 2.19-.13.09-2.383 1.37-2.383 4.19 0 3.26 2.854 4.42 2.955 4.45z"/></svg>';
const PLAY_ICON =
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 3.5v17l9-8.5z" fill="#fff"/><path d="M4 3.5l12.5 6.9-3.5 2.1z" fill="#fff" opacity=".8"/><path d="M4 20.5l12.5-6.9-3.5-2.1z" fill="#fff" opacity=".8"/><path d="M16.5 10.4l3.2 1.8c.4.2.4 .8 0 1l-3.2 1.8-3.5-2.3z" fill="#fff" opacity=".6"/></svg>';

const badges = [
  { name: 'App Store', href: SITE.appStoreUrl, icon: APPLE_ICON },
  { name: 'Google Play', href: SITE.playStoreUrl, icon: PLAY_ICON },
];
---

<div class="badges" id={id}>
  {
    badges.map((b) =>
      live ? (
        <a href={b.href} class="badge" rel="noopener" target="_blank">
          <Fragment set:html={b.icon} />
          <span class="text">
            <span class="top">{topLabel}</span>
            <span class="name">{b.name}</span>
          </span>
        </a>
      ) : (
        <span class="badge is-disabled" aria-disabled="true">
          <Fragment set:html={b.icon} />
          <span class="text">
            <span class="top">{topLabel}</span>
            <span class="name">{b.name}</span>
          </span>
        </span>
      ),
    )
  }
</div>

<style>
  .badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--color-text);
    color: #fff;
    border-radius: 14px;
    padding: 10px 16px 10px 12px;
    min-height: 52px;
    transition: transform 0.15s;
  }

  .badge:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  .badge.is-disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .badge.is-disabled:hover {
    transform: none;
  }

  .text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .top {
    font-size: 10px;
    font-weight: 500;
    opacity: 0.75;
    letter-spacing: 0.3px;
  }

  .name {
    font-size: 16px;
    font-weight: 600;
  }
</style>
