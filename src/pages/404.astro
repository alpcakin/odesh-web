---
import { getDictionary, homePath } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandMark from '@/components/BrandMark.astro';

const tr = getDictionary('tr');
const en = getDictionary('en');
---

<BaseLayout locale="tr" title={`${tr.meta.notFoundTitle} - odesh`} description={tr.meta.notFoundBody} path="/404/" noindex>
  <main class="wrap">
    <BrandMark width={72} />
    <div class="code">404</div>
    <h1 class="title">{tr.meta.notFoundTitle}</h1>
    <p class="body">{tr.meta.notFoundBody}</p>
    <p class="body en" lang="en">{en.meta.notFoundBody}</p>
    <div class="actions">
      <a href={homePath('tr')} class="btn">{tr.meta.notFoundCta}</a>
      <a href={homePath('en')} class="btn ghost" lang="en" hreflang="en">{en.meta.notFoundCta}</a>
    </div>
  </main>
</BaseLayout>

<style>
  .wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 14px;
    padding: 64px var(--gutter);
  }

  .code {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: var(--color-text-muted);
    margin-top: 12px;
  }

  .title {
    margin: 0;
    font-size: clamp(30px, 4vw, 44px);
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .body {
    margin: 0;
    font-size: 16px;
    color: var(--color-text-muted);
    max-width: 440px;
    text-wrap: pretty;
  }

  .body.en {
    font-size: 14px;
  }

  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    background: var(--color-primary);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    padding: 12px 20px;
    border-radius: 999px;
  }

  .btn:hover {
    background: var(--color-primary-hover);
    color: #fff;
  }

  .btn.ghost {
    background: var(--color-surface);
    color: var(--color-primary);
    border: 1px solid var(--color-border);
  }

  .btn.ghost:hover {
    background: var(--color-primary-soft);
  }
</style>
