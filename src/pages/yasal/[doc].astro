---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import LegalPage from '@/components/LegalPage.astro';

export const getStaticPaths = (async () => {
  const docs = await getCollection('legal');
  return docs.map((doc) => ({ params: { doc: doc.id }, props: { doc, allDocs: docs } }));
}) satisfies GetStaticPaths;

const { doc, allDocs } = Astro.props;
---

<LegalPage locale="tr" doc={doc} allDocs={allDocs} />
